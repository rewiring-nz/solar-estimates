# Example env file for running the S3 DSM downloader and/or the full pipeline on a small subset of the Queenstown Lakes District DSM.
# Use with: CONFIG_FILE=configs/suburb_ShotoverCountry_s3_minimal.env docker compose run --rm pipeline

DOWNLOAD_DSM=false
# STAC collection URL for the source dataset.
S3_STAC_COLLECTION_URL=https://nz-elevation.s3.ap-southeast-2.amazonaws.com/otago/queenstown_2021/dsm_1m/2193/collection.json
# Required STAC asset key to download from each item (strict, no guessing).
DOWNLOAD_ASSET_KEY=visual
# Collection-tile mode: loops every tile in S3_STAC_COLLECTION_URL, downloads each tile
# and its W/NW/N/NE/E neighbors on demand, then runs solar calculation for each tile.
PROCESS_COLLECTION_TILES=true
# Skip tiles that already have a completed output file (resume-friendly)
SKIP_COMPLETED_TILES=true

# Any non-empty value enables raster export
EXPORT_RASTERS=true  

# Logical name used in logs/output naming.  Per-tile outputs are named
# {OUTPUT_AREA_NAME}_tile_{TILE_ID} automatically.
OUTPUT_AREA_NAME=suburb_ShotoverCountry_s3_minimal
# Building outlines dataset used by pipeline statistics/masking.
INPUT_BUILDING_DIR=data/inputs/building_outlines/district_QueenstownLakes/shotover_country_building_stats.gpkg
# Layer name created inside GRASS for building outlines.
OUTPUT_BUILDING_LAYER_NAME=queenstown_lakes_buildings


# Directory where downloaded DSM tiles are cached.
OUTPUT_DSM_DIR=data/inputs/DSM/suburb_ShotoverCountry_s3_minimal
# JSONL manifest path for audit trail (downloaded/skipped/failed).
DOWNLOAD_MANIFEST_PATH=data/inputs/DSM/suburb_ShotoverCountry_s3_minimal/download_manifest.jsonl

# Rename .tiff assets to .tif on disk for compatibility.
SAVE_AS_TIF=true
# If true, re-download even when an existing valid file is present.
OVERWRITE=false
# Per-request network timeout in seconds for STAC metadata and HEAD requests.
REQUEST_TIMEOUT_SECONDS=30

# Solar calculation parameters
KEY_DAYS=105
TIME_STEP=3.0
# Number of retries after initial failure (2 means up to 3 attempts total).
MAX_DOWNLOAD_RETRIES=2
# Pipeline sampling days.
# Midpoints for summer, autumn=spring, winter (Southern Hemisphere)
# KEY_DAYS=15 105 196
KEY_DAYS=105
# Larger time step reduces r.sun workload (hours).
TIME_STEP=3.0
# Enable horizon so adjacent tiles influence shading.
CALCULATE_HORIZON=false
# Wider local horizon search radius (metres) to capture inter-tile effects.
DSM_BUFFER_DISTANCE=10

DEM_BUFFER_DISTANCE=100
# Clip final processing to target tile CC11_10000_0104 extent (north,south,east,west).
REGION_BBOX=5010000,5002800,1271200,1266400
# Number of parallel processes for r.sun computation (default: 1 for low memory).
N_PROCS=1