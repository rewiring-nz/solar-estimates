# Base defaults for pipeline configuration.
# Precedence: CLI flags > --config scenario file > this file.

OUTPUT_PREFIX=solar_on_buildings
MAX_SLOPE=45.0
# Midpoints for summer, autumn=spring, winter (Southern Hemisphere)
KEY_DAYS=15 105 196
TIME_STEP=1.0
N_PROCS=1

# Optional region clipping in project CRS (north,south,east,west)
# REGION_BBOX=

# Optional exports
EXPORT_RASTERS=false

# Horizon pre-calculation defaults
CALCULATE_HORIZON=false
DSM_BUFFER_DISTANCE=30
DEM_BUFFER_DISTANCE=10000
HORIZON_STEP_DEGREES=30
HORIZON_START_AZIMUTH=315
HORIZON_END_AZIMUTH=135

# Optional 8m DEM glob for regional horizon
# INPUT_DEM_GLOB=

# Optional weather adjustment inputs
# WRF_FILE=
SOURCE_CRS=EPSG:4326
TARGET_CRS=EPSG:2193

# Optional pre-download step before pipeline
DOWNLOAD_DSM=false

# Optional per-input-tile mode for restart resilience
PROCESS_PER_INPUT_TILE=false
SKIP_COMPLETED_TILES=true

# Collection-driven mode: fetch all tiles from S3_STAC_COLLECTION_URL, download
# each tile's W/NW/N/NE/E neighbors on demand, and run per-tile solar calculation.
PROCESS_COLLECTION_TILES=false
# When true, ignore neighboring tiles and process only the target tile.
IGNORE_NEIGHBOR=false
